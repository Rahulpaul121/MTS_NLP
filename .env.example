# Copy to .env or export these in your shell before running api.py

# Google Drive file id of the model zip (from the sharing link
# https://drive.google.com/file/d/<THIS_PART>/view?usp=sharing)
DRIVE_FILE_ID=

# ...or paste the full sharing link instead:
# DRIVE_FILE_URL=https://drive.google.com/file/d/XXXX/view?usp=sharing

# Where the API caches the downloaded model (default shown)
MODEL_PATH=./models/hinglish_summarizer_50k

# CORS origins for the API, comma-separated (default * for local use)
ALLOWED_ORIGINS=*

# Used by streamlit_app.py — where the FastAPI backend is running
API_URL=http://127.0.0.1:8000
